---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import ProviderBadge from './ProviderBadge.astro';
import TagPill from './TagPill.astro';
import ContentWarning from './ContentWarning.astro';
import JsonLd from './JsonLd.astro';
import {
  byDateDesc,
  formatDate,
  relatedEntries,
  entryPath,
  facetTags,
  liveEntries,
  PROVIDER_LABELS,
  type Entry,
} from '../lib/entries';
import { entryJsonLd, breadcrumbJsonLd } from '../lib/seo';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { title, description, source_url, provider, tags, date_discovered, curator_note, content_warning, reddit_url, kind } =
  entry.data;
const all = (await liveEntries()).sort(byDateDesc);
const related = relatedEntries(entry, all);
const facet = facetTags(all);
const hasBody = entry.body && entry.body.trim().length > 0;
const { Content } = await render(entry);
const providerLabel = PROVIDER_LABELS[provider] ?? provider;
const isArtifact = kind === 'artifact';
const listPath = isArtifact ? '/artifacts/' : '/chats/';
const listName = isArtifact ? 'All artifacts' : 'All chats';
const path = entryPath(entry);
---

<Base title={`${title} — SharedChats`} description={description} image={`/og${path.slice(0, -1)}.png`} type="article">
  <JsonLd
    slot="head"
    data={[
      entryJsonLd({
        title,
        description,
        path,
        datePublished: date_discovered,
        providerLabel,
        sourceUrl: source_url,
        aboutType: isArtifact ? 'CreativeWork' : 'Conversation',
      }),
      breadcrumbJsonLd([
        { name: 'Home', path: '/' },
        { name: listName, path: listPath },
        { name: title, path },
      ]),
    ]}
  />
  <article class="mx-auto max-w-3xl py-10" data-pagefind-body>
    <nav class="text-sm text-zinc-600 dark:text-zinc-400" aria-label="Breadcrumb" data-pagefind-ignore>
      <a href={listPath} class="hover:underline">{listName}</a>
      <span aria-hidden="true"> / </span>
      <span class="text-zinc-700 dark:text-zinc-300">{providerLabel}</span>
    </nav>

    <h1
      class="mt-4 text-2xl font-bold tracking-tight text-zinc-900 sm:text-3xl dark:text-zinc-50"
      data-kind={isArtifact ? 'Artifact' : 'Chat'}
      data-provider={providerLabel}
      data-pagefind-filter="kind[data-kind], provider[data-provider]"
    >
      {title}
    </h1>

    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm text-zinc-600 dark:text-zinc-400" data-pagefind-ignore>
      <ProviderBadge provider={provider} />
      {
        isArtifact && (
          <span class="inline-block rounded-full bg-indigo-100 px-2 py-0.5 text-xs font-medium text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
            Artifact
          </span>
        )
      }
      <span>
        Discovered <time datetime={date_discovered.toISOString().slice(0, 10)}>{formatDate(date_discovered)}</time>
      </span>
    </div>

    {content_warning && <div class="mt-5" data-pagefind-ignore><ContentWarning warning={content_warning} /></div>}

    <p class="mt-5 text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">{description}</p>

    {
      curator_note && (
        <aside hidden data-pagefind-ignore class="mt-5 rounded-md border-l-4 border-amber-500 bg-zinc-50 px-4 py-3 dark:bg-zinc-900">
          <p class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Why we picked it</p>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{curator_note}</p>
        </aside>
      )
    }

    <div class="mt-6 flex flex-wrap items-center gap-3" data-pagefind-ignore>
      <a
        href={source_url}
        target="_blank"
        rel="noopener nofollow ugc"
        class="inline-block rounded-md bg-zinc-900 px-5 py-2.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-zinc-300"
        >Open original {isArtifact ? 'artifact' : 'chat'} &nearr;</a
      >
      {
        reddit_url && (
          <a
            href={reddit_url}
            target="_blank"
            rel="noopener nofollow ugc"
            class="inline-block rounded-md border border-zinc-300 px-5 py-2.5 text-sm font-medium text-zinc-700 hover:border-zinc-500 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500"
          >
            Discuss
          </a>
        )
      }
    </div>

    {/* Deliberately NOT pagefind-ignored: a tag is the only place a topic word like
        "three-js" appears on the page, so ignoring this block left tags unsearchable.
        Tags at or above TAG_FACET_MIN also carry a filter value. Pagefind skips
        hidden elements, so the facet has to hang off the visible pill. */}
    <div class="mt-6 flex flex-wrap gap-1.5">
      {
        tags.map((t) =>
          facet.has(t) ? (
            <span data-pagefind-filter={`tag:${t}`}>
              <TagPill tag={t} />
            </span>
          ) : (
            <TagPill tag={t} />
          )
        )
      }
    </div>

    {
      hasBody && (
        <div class="prose prose-zinc mt-8 max-w-none text-zinc-700 dark:text-zinc-300">
          <Content />
        </div>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-12" aria-labelledby="related" data-pagefind-ignore>
          <h2 id="related" class="text-lg font-semibold text-zinc-900 dark:text-zinc-50">
            Related
          </h2>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {related.map((e) => (
              <Card entry={e} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</Base>
