---
import ProviderBadge from './ProviderBadge.astro';
import TagPill from './TagPill.astro';
import { formatDate, entryPath, type Entry } from '../lib/entries';

interface Props {
  entry: Entry;
}

const { entry } = Astro.props;
const { title, description, provider, tags, date_discovered, content_warning, featured } = entry.data;
---

<article
  class="flex h-full flex-col rounded-lg border border-zinc-200 p-4 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600"
>
  <h3 class="font-semibold leading-snug text-zinc-900 dark:text-zinc-50">
    <a href={entryPath(entry)} class="hover:underline">{title}</a>
  </h3>
  <p class="mt-2 line-clamp-2 flex-1 text-sm text-zinc-600 dark:text-zinc-400">{description}</p>
  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400">
    <ProviderBadge provider={provider} />
    {
      entry.data.kind === 'artifact' && (
        <span class="inline-block rounded-full bg-indigo-100 px-2 py-0.5 font-medium text-indigo-800 dark:bg-indigo-950 dark:text-indigo-300">
          Artifact
        </span>
      )
    }
    <time datetime={date_discovered.toISOString().slice(0, 10)}>{formatDate(date_discovered)}</time>
    {featured && <span class="font-medium text-amber-600 dark:text-amber-500">★ Editor’s pick</span>}
    {
      content_warning && (
        <span
          class="rounded border border-amber-400 px-1 font-medium text-amber-700 dark:border-amber-600 dark:text-amber-400"
          title={content_warning}
        >
          CW
        </span>
      )
    }
  </div>
  <div class="mt-2 flex flex-wrap gap-1.5">
    {tags.map((t) => <TagPill tag={t} />)}
  </div>
</article>
