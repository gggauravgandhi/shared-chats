---
import Base from '../../layouts/Base.astro';
import JsonLd from '../../components/JsonLd.astro';
import { liveEntries, tagCounts } from '../../lib/entries';
import { collectionPageJsonLd } from '../../lib/seo';

const entries = await liveEntries();
const { categories, tags } = tagCounts(entries);

const CATEGORY_CLASS =
  'inline-flex items-center gap-1.5 rounded-full border border-zinc-800 bg-zinc-800 px-3 py-1 text-sm font-medium text-zinc-100 hover:border-zinc-600 hover:bg-zinc-600 dark:border-zinc-200 dark:bg-zinc-200 dark:text-zinc-900 dark:hover:border-white dark:hover:bg-white';
const TAG_CLASS =
  'inline-flex items-center gap-1.5 rounded-full border border-zinc-300 px-3 py-1 text-sm text-zinc-700 hover:border-zinc-500 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100';
---

<Base
  title="Browse by tag — SharedChats"
  description="Every tag on SharedChats with entry counts. Find curated AI conversations about coding, science, philosophy, humor and more."
>
  <JsonLd
    slot="head"
    data={collectionPageJsonLd({
      name: 'Browse by tag',
      description: 'Every tag on SharedChats with entry counts.',
      path: '/tags/',
      itemPaths: [...categories, ...tags].map(([tag]) => `/tags/${tag}/`),
    })}
  />
  <section class="py-10">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Browse by tag</h1>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-400">
      Every entry has one category and four tags. {categories.length} categories and {tags.length} tags
      across {entries.length} entries, sorted by count.
    </p>

    <h2 class="mt-8 text-lg font-semibold text-zinc-900 dark:text-zinc-50">Categories</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        categories.map(([tag, count]) => (
          <li>
            <a href={`/tags/${tag}/`} class={CATEGORY_CLASS}>
              {tag}
              <span class="text-xs opacity-70">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 text-lg font-semibold text-zinc-900 dark:text-zinc-50">Tags</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        tags.map(([tag, count]) => (
          <li>
            <a href={`/tags/${tag}/`} class={TAG_CLASS}>
              {tag}
              <span class="text-xs text-zinc-600 dark:text-zinc-400">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
