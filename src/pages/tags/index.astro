---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const entries = await getCollection('entries');
const counts = new Map<string, number>();
for (const e of entries) {
  for (const t of e.data.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
---

<Base
  title="Browse by tag — SharedChats"
  description="Every tag on SharedChats with entry counts. Find curated AI conversations about coding, science, philosophy, humor and more."
>
  <section class="py-10">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Tags</h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
      {tags.length} tags across {entries.length} conversations, sorted by count.
    </p>
    <ul class="mt-6 flex flex-wrap gap-2">
      {
        tags.map(([tag, count]) => (
          <li>
            <a
              href={`/tags/${tag}/`}
              class="inline-flex items-center gap-1.5 rounded-full border border-zinc-300 px-3 py-1 text-sm text-zinc-700 hover:border-zinc-500 hover:text-zinc-900 dark:border-zinc-700 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:text-zinc-100"
            >
              {tag}
              <span class="text-xs text-zinc-400 dark:text-zinc-500">{count}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
