---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { PROVIDER_LABELS, formatDate } from '../lib/entries';
import { computeStats } from '../lib/stats';

const entries = await getCollection('entries');
const stats = computeStats(entries);
const maxMonth = Math.max(...stats.perMonth.map(([, n]) => n));
const maxTag = stats.topTags.length ? stats.topTags[0][1] : 1;

function monthLabel(ym: string): string {
  const [y, m] = ym.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, 1)).toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
}
---

<Base
  title="Stats — SharedChats"
  description="Build-time statistics for SharedChats: total curated conversations, entries per provider, top tags, and additions per month."
>
  <section class="py-10">
    <h1 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">Stats</h1>
    <p class="mt-2 text-sm text-zinc-500 dark:text-zinc-400">
      Computed at build time from the entry collection. Latest addition: {formatDate(stats.latest)}.
    </p>

    <dl class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
        <dt class="text-sm text-zinc-500 dark:text-zinc-400">Total entries</dt>
        <dd class="mt-1 text-3xl font-bold text-zinc-900 dark:text-zinc-50">{stats.total}</dd>
      </div>
      <div class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
        <dt class="text-sm text-zinc-500 dark:text-zinc-400">Providers</dt>
        <dd class="mt-1 text-3xl font-bold text-zinc-900 dark:text-zinc-50">{stats.perProvider.length}</dd>
      </div>
    </dl>

    <h2 class="mt-10 text-lg font-semibold text-zinc-900 dark:text-zinc-50">Entries per provider</h2>
    <ul class="mt-4 space-y-2">
      {
        stats.perProvider.map(([provider, count]) => (
          <li class="flex items-center gap-3 text-sm">
            <span class="w-24 shrink-0 text-zinc-600 dark:text-zinc-400">{PROVIDER_LABELS[provider] ?? provider}</span>
            <span
              class="h-4 rounded-sm bg-amber-500"
              style={`width: ${Math.max(2, (count / stats.total) * 100)}%`}
              aria-hidden="true"
            />
            <span class="text-zinc-500">{count}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 text-lg font-semibold text-zinc-900 dark:text-zinc-50">Top 20 tags</h2>
    <ul class="mt-4 space-y-2">
      {
        stats.topTags.map(([tag, count]) => (
          <li class="flex items-center gap-3 text-sm">
            <a href={`/tags/${tag}/`} class="w-44 shrink-0 truncate text-zinc-600 hover:underline dark:text-zinc-400">
              {tag}
            </a>
            <span
              class="h-4 rounded-sm bg-zinc-400 dark:bg-zinc-600"
              style={`width: ${Math.max(2, (count / maxTag) * 60)}%`}
              aria-hidden="true"
            />
            <span class="text-zinc-500">{count}</span>
          </li>
        ))
      }
    </ul>

    <h2 class="mt-10 text-lg font-semibold text-zinc-900 dark:text-zinc-50">Entries added per month</h2>
    <ul class="mt-4 space-y-2">
      {
        stats.perMonth.map(([month, count]) => (
          <li class="flex items-center gap-3 text-sm">
            <span class="w-24 shrink-0 text-zinc-600 dark:text-zinc-400">{monthLabel(month)}</span>
            <span
              class="h-4 rounded-sm bg-emerald-500"
              style={`width: ${Math.max(2, (count / maxMonth) * 80)}%`}
              aria-hidden="true"
            />
            <span class="text-zinc-500">{count}</span>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
