---
import Base from '../layouts/Base.astro';
---

<Base
  title="SharedChats — Interesting AI conversations, curated by humans"
  description="A human-curated index of interesting, publicly shared AI conversations from Claude, ChatGPT, Gemini and more. Browse, search, and read the originals."
>
  <section class="py-16">
    <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      Interesting AI conversations, curated by humans
    </h1>
    <p class="mt-4 max-w-2xl text-zinc-600 dark:text-zinc-400">
      SharedChats collects publicly shared AI conversations worth reading and
      links you to the originals. Site under construction.
    </p>
  </section>
</Base>
